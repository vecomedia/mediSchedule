generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  DOCTOR
  PATIENT
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  name                   String
  passwordHash           String
  role                   UserRole
  phone                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  patientProfile         PatientProfile?
  doctorProfile          Doctor?
  createdAppointments    Appointment[]           @relation("appointmentsCreatedBy")
  idempotencyKeys        AppointmentIdempotency[]
}

model PatientProfile {
  id                     String        @id @default(cuid())
  userId                 String        @unique
  dateOfBirth            DateTime?
  status                 String        @default("active")
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments           Appointment[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([status])
}

model Doctor {
  id                     String        @id @default(cuid())
  userId                 String?       @unique
  name                   String
  specialty              String
  avatar                 String?
  user                   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments           Appointment[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([name])
}

model Appointment {
  id                     String                @id @default(cuid())
  patientId              String
  doctorId               String
  createdByUserId        String
  startAt                DateTime
  endAt                  DateTime
  status                 AppointmentStatus     @default(PENDING)
  type                   String
  reason                 String
  notes                  String?
  patient                PatientProfile        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor                 Doctor                @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy              User                  @relation("appointmentsCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  idempotencyEntries     AppointmentIdempotency[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([doctorId, startAt])
  @@index([patientId, startAt])
  @@index([status])
}

model AppointmentIdempotency {
  id                     String       @id @default(cuid())
  key                    String
  userId                 String
  appointmentId          String
  createdAt              DateTime     @default(now())
  appointment            Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
  @@index([appointmentId])
}
